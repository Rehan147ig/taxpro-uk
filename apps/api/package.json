{
  "name": "@taxpro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run build -w @taxpro/tax-engine && npm run build -w @taxpro/tax-engine-enterprise",
    "predev": "npm run build -w @taxpro/tax-engine && npm run build -w @taxpro/tax-engine-enterprise",
    "prebuild": "npm run build -w @taxpro/tax-engine && npm run build -w @taxpro/tax-engine-enterprise",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/agent/instructions.md','dist/agent/instructions.md')\"",
    "lint": "tsc --noEmit",
    "start": "node --import ./dist/telemetry.js dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:synthetic": "tsx scripts/synthetic-seed.ts",
    "db:synthetic-q1": "tsx scripts/synthetic-seed.ts q1-only",
    "test": "vitest run",
    "eval:uk": "tsx scripts/eval/run-uk-eval.ts",
    "eval:ai-mapping": "tsx scripts/eval/run-ai-mapping-eval.ts",
    "harness": "tsx scripts/eval/run-agent-harness.ts",
    "harness:real": "cross-env AI_EVAL_MODE=real tsx scripts/eval/run-agent-harness.ts",
    "test:integration": "tsx scripts/test-provision-flow.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@superlog/otel-helpers": "^0.1.1",
    "@taxpro/tax-engine": "*",
    "@taxpro/tax-engine-enterprise": "*",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.28.0",
    "jszip": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
