    "db:seed": "turbo run db:seed",
    "eval:uk": "turbo run eval:uk"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^10.0.4",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.10"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "drizzle-kit": {
      "esbuild": "^0.25.12"
    },
    "esbuild-register": {
      "esbuild": "^0.25.12"
    },
    "@tanstack/router-plugin": {
