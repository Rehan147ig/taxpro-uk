# Database
# ---- Production ----
# Runtime (NOBYPASSRLS, RLS enforced):
#   DATABASE_URL=postgres://taxpro_app:PASSWORD@host:5432/taxpro
# Migrations (schema owner):
#   DATABASE_URL_MIGRATIONS=postgres://taxpro_migrations:PASSWORD@host:5432/taxpro
#
# Run scripts/bootstrap-roles.sql as superuser to create the roles.
# ---- Dev fallback ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taxpro
DATABASE_URL_MIGRATIONS=postgres://postgres:postgres@localhost:5432/taxpro

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
DATA_ENCRYPTION_KEY=change-me-to-a-32-character-secret
CORS_ORIGIN=http://localhost:5173

# ---- AI Provider ----
# Pick one:
#   openai  -> AI_BASE_URL=https://api.openai.com/v1,  AI_MODEL=gpt-4o-mini
#   nvidia  -> AI_BASE_URL=https://integrate.api.nvidia.com/v1,  AI_MODEL=z-ai/glm-5.2
#   interfaze -> uses INTERFAZE_API_KEY + INTERFAZE_ENDPOINT
#   custom  -> set your own base URL + model name
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Legacy fallback if AI_API_KEY is empty
OPENAI_API_KEY=sk-...

# NetSuite OAuth (default sandbox, override per connection)
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_REALM=
NETSUITE_BASE_URL=

# Interfaze AI, multimodal parsing provider (OpenAI-compatible)
INTERFAZE_API_KEY=
INTERFAZE_ENDPOINT=https://api.interfaze.ai/v1

# Companies House (for UK benchmark harness)
# Get a free API key at https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# Server
PORT=3001
NODE_ENV=development

# Rate limiting (development-only overrides; production keeps strict defaults).
# AUTH_RATE_LIMIT_MAX — failed login/register attempts per IP per 15 min
#   (default: 5 in production, 60 in development; dev server launcher sets 200).
# API_RATE_LIMIT_MAX — requests per IP per minute (generic API limiter)
#   (default: 100 in production, 1000 in development).
# Do NOT set these in production unless you have explicitly reviewed the limit.
# AUTH_RATE_LIMIT_MAX=
# API_RATE_LIMIT_MAX=

# Node options (e.g., --max-old-space-size=4096 for large UK eval runs)
NODE_OPTIONS=
